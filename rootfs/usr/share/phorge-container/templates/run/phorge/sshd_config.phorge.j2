# Generated by phorge-prepare. Dedicated SSHD for Phorge Git-over-SSH.
Port 22

HostKey /var/lib/phorge/ssh-host-keys/ssh_host_ed25519_key
HostKey /var/lib/phorge/ssh-host-keys/ssh_host_rsa_key
PidFile /run/sshd-phorge.pid

AuthorizedKeysCommand {{ ssh_hook_path }}
AuthorizedKeysCommandUser {{ vcs_user }}
AuthorizedKeysFile none
AllowUsers {{ vcs_user }}

PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no

AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
PrintMotd no
PrintLastLog no
UsePAM no
LogLevel VERBOSE
