PHORGE_WEB_PORT=8080
PHORGE_SSH_PORT=2222
PHORGE_BASE_URI=http://phorge.localhost:8080/

# Keep component source revisions synchronized with the checked-out submodules.
PHORGE_GIT_REV=20aaead687fcc9376560adfa57c13a2201faedd4
ARCANIST_GIT_REV=63de5a2953b79dbe6aac4ed92bdb64b45cad53d6

# MySQL account and database namespace. These initialize a new mysql-data volume;
# changing them later requires a database migration. Passwords live in ./secrets.
PHORGE_DB_USER=phorge
PHORGE_DB_NAMESPACE=phabricator

# Adjust this to the memory available to the database host/container.
MYSQL_INNODB_BUFFER_POOL_SIZE=1600M

# Set to 0 only when schema upgrades are performed manually.
PHORGE_AUTO_STORAGE_UPGRADE=1
